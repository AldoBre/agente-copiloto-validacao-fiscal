# ============================================================
# Copie para .env e ajuste.  NUNCA versione o .env.
# ============================================================

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Chave Fernet usada para criptografar as API keys dos provedores de IA.
# Gere com:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Se ficar vazia, é derivada da DJANGO_SECRET_KEY (ok para dev, ruim para prod).
APP_ENCRYPTION_KEY=

# --- Banco de dados ---------------------------------------------------------
# PostgreSQL é o banco do projeto e o padrão (mesmo sem DB_ENGINE definido).
# Para rodar sem infraestrutura nenhuma: DB_ENGINE=sqlite (db.sqlite3; só dev).
DB_ENGINE=postgres
DB_NAME=agente_implantacao
DB_USER=agente
DB_PASSWORD=agente_dev_local
DB_HOST=127.0.0.1
DB_PORT=5435

# TLS da conexão. 'prefer' (padrão) serve para o Postgres em container local,
# que não tem certificado. Fora da máquina local use no mínimo 'require':
# 'prefer' degrada para texto claro sem avisar se o servidor não oferecer TLS.
#   require      → exige criptografia, não valida o certificado
#   verify-full  → exige e valida (precisa de DB_SSLROOTCERT) — recomendado
# `python manage.py check --deploy` avisa se isto ficar frouxo.
DB_SSLMODE=prefer
# DB_SSLROOTCERT=/caminho/DigiCertGlobalRootCA.crt.pem

# Conexão persistente, em segundos. Bancos gerenciados limitam conexões por
# plano, e o limite é gasto por worker — suba com cuidado.
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10

# --- Comparador fiscal ------------------------------------------------------
# Tolerância absoluta (R$) para considerar dois valores monetários iguais.
COMPARADOR_TOLERANCIA_MONETARIA=0.01
# Tolerância absoluta (pontos percentuais) para alíquotas.
COMPARADOR_TOLERANCIA_PERCENTUAL=0.01
# Escopo da comparação:
#   impostos (padrão) = só grupos de imposto + classificação fiscal do item
#   completo          = inclui cabeçalho, totalizadores e campos comerciais
COMPARADOR_ESCOPO=impostos

# --- Provedores de IA -------------------------------------------------------
# Estas variáveis são apenas um FALLBACK. O caminho recomendado é cadastrar
# os provedores pela tela /configuracoes/ (as chaves ficam criptografadas no banco).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
